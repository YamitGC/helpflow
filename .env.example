# ========================================================
# HelpFlow - Variables de Entorno de Configuración
# Copia este archivo como .env para personalizar variables locales:
#   cp .env.example .env
# ========================================================

# Base de Datos PostgreSQL
POSTGRES_DB=helpflow_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_PORT=5433

# Puertos de Microservicios
SUPPORT_SERVICE_PORT=8080
TECHNICIAN_DISPATCH_PORT=8081

# Seguridad JWT (Secreto HMAC-SHA256 mínimo 256 bits / 32 bytes)
# Generar una clave segura con: openssl rand -hex 32
JWT_SECRET=tu_clave_secreta_hex_de_al_menos_256_bits_aqui
JWT_EXPIRATION=86400000

# URLs de Comunicación Inter-servicios
TECHNICIAN_DISPATCH_URL=http://technician-dispatch-service:8081

